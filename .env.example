# Supabase project settings: Dashboard → Project Settings → API Keys.
# The publishable key (sb_publishable_...) or the legacy anon key both work.
# Both values are safe in the browser; Row-Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
